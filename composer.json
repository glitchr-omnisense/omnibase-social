{
    "name": "omnibase/social",
    "description": "Social publishing for omnibase: a reel rendered from the site’s own template (ffmpeg), published on each network through omnisense/omnipost, and the account’s feed cached for a wall on the site.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^2.15|^3.0",
        "doctrine/doctrine-bundle": "^2.11|^3.0",
        "symfony/doctrine-bridge": "^6.4|^7.0|^8.0",
        "omnibridge/symfony": "^1.1 || ^2.0",
        "omnisense/omnibase": "^5.1 || ^6.0",
        "omnibase/admin": "^1.0",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/security-bundle": "^6.0|^7.0|^8.0",
        "omnisense/omnipost": "^1.0",
        "symfony/process": "^6.0|^7.0|^8.0",
        "symfony/messenger": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {"Base\\Social\\": "./src"}
    },
    "autoload-dev": {
        "psr-4": {"Base\\Social\\Tests\\": "./tests"}
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "omnibridge/composer": true,
            "php-http/discovery": true
        }
    }
}
